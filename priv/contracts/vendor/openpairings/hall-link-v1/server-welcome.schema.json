{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/teapot-chess/openpairings/main/priv/contracts/hall-link-v1/server-welcome.schema.json",
  "title": "welcome (server to device)",
  "description": "The line is up. Followed by the device's `settings` and the latest published round, if there is one.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "type",
    "v",
    "server",
    "tournament"
  ],
  "properties": {
    "type": {
      "const": "welcome"
    },
    "v": {
      "$ref": "common.schema.json#/definitions/version"
    },
    "server": {
      "type": "string",
      "description": "A name to show for the server."
    },
    "tournament": {
      "$ref": "common.schema.json#/definitions/tournament_ref"
    }
  }
}
