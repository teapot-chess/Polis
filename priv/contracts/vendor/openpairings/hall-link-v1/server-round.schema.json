{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/teapot-chess/openpairings/main/priv/contracts/hall-link-v1/server-round.schema.json",
  "title": "round (server to device)",
  "description": "The latest published round, after `welcome` and whenever its `rev` changes or a newer round is published. A round taken back is never sent.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "type",
    "round"
  ],
  "properties": {
    "type": {
      "const": "round"
    },
    "round": {
      "$ref": "common.schema.json#/definitions/round_payload"
    }
  }
}
